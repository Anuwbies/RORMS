{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "test:reservation-logs": "npm run build && node --test tests/reservationStatusLogs.test.cjs",
    "test:member-logs": "npm run build && node --test tests/memberAccountLogs.test.cjs",
    "test:facility-logs": "npm run build && node --test tests/facilityLogs.test.cjs",
    "test:schedule-logs": "npm run build && node --test tests/workbookScheduleLogs.test.cjs",
    "test:reservation-conflicts": "npm run build && node --test tests/cancelScheduleReservations.test.cjs",
    "test:semester-phases": "npm run build && node --test tests/semesterPhaseUpdates.test.cjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.2.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3"
  },
  "private": true
}
