rules_version = '2';

// Deployment note (user-supplied, 2026-10-12): the currently deployed rules
// allow all top-level document reads/writes and all nested reads/writes except
// users/{userId}/notifications/{notificationId}. Notifications require the
// recipient's authentication for read/update/delete and deny client creation.
// This local file contains stricter collection-specific rules; it does not
// represent the deployed policy until explicitly deployed.
// Firestore rules do not control HTTPS callable CORS or function deployment.
// updateReservationStatus must be built and deployed separately; a missing
// function endpoint can return a 404 without CORS headers even with open rules.

service cloud.firestore {
  match /databases/{database}/documents {
    function canManageCourses(departmentId, membershipId) {
      let member = get(/databases/$(database)/documents/memberships/$(membershipId)).data;
      let department = get(/databases/$(database)/documents/departments/$(departmentId)).data;
      return request.auth != null && member.userId == request.auth.uid && member.status == 'accepted'
        && (member.role == 'Admin' || (member.role in ['Dean', 'Program Head'] && member.department == department.code));
    }

    match /departments/{departmentId}/courseWorkbooks/current {
      function validCoursesWorkbook() {
        let data = request.resource.data;
        return request.auth != null
          && data.keys().hasAll(['schemaVersion', 'encoding', 'data', 'jsonByteLength', 'departmentId', 'departmentCode', 'membershipId', 'savedBy', 'fileName', 'revision', 'generation', 'courseCount', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['schemaVersion', 'encoding', 'data', 'jsonByteLength', 'departmentId', 'departmentCode', 'membershipId', 'savedBy', 'fileName', 'revision', 'generation', 'courseCount', 'createdAt', 'updatedAt'])
          && data.schemaVersion == 1 && data.encoding == 'gzip-base64'
          && data.data is string && data.data.size() > 0 && data.data.toUtf8().size() <= 921600
          && data.jsonByteLength is int && data.jsonByteLength > 0 && data.jsonByteLength <= 52428800
          && data.departmentId == departmentId && data.departmentCode == get(/databases/$(database)/documents/departments/$(departmentId)).data.code
          && data.membershipId is string && data.savedBy == request.auth.uid
          && data.fileName is string && data.fileName.size() > 5 && data.fileName.size() <= 255 && data.fileName.matches('.*[.][xX][lL][sS][xX]')
          && data.revision is int && data.revision > 0 && data.generation is string && data.generation.matches('[a-zA-Z0-9_-]+')
          && data.courseCount is int && data.courseCount >= 0 && data.createdAt is timestamp && data.updatedAt == request.time
          && canManageCourses(departmentId, data.membershipId);
      }
      allow read: if request.auth != null;
      allow create: if validCoursesWorkbook() && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
      allow update: if validCoursesWorkbook() && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.generation != resource.data.generation;
      allow delete: if false;
    }

    match /departments/{departmentId}/summaryWorkbooks/{termId} {
      function validSummaryWorkbook() {
        let data = request.resource.data;
        return request.auth != null
          && data.keys().hasAll(['schemaVersion', 'departmentId', 'academicYearId', 'semester', 'membershipId', 'savedBy', 'revision', 'state', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['schemaVersion', 'departmentId', 'academicYearId', 'semester', 'membershipId', 'savedBy', 'revision', 'state', 'createdAt', 'updatedAt'])
          && data.schemaVersion == 1 && data.departmentId == departmentId
          && data.academicYearId is string && data.semester in ['sem1', 'sem2']
          && termId == data.academicYearId + '_' + data.semester
          && data.membershipId is string && data.savedBy == request.auth.uid
          && data.revision is int && data.revision > 0
          && data.state is map && data.state.keys().hasAll(['rows', 'fileName', 'sourceData'])
          && data.state.keys().hasOnly(['rows', 'fileName', 'sourceData', 'columnWidths'])
          && data.state.rows is list && data.state.rows.size() >= 2 && data.state.rows.size() <= 1000
          && data.state.fileName is string && data.state.fileName.size() > 5 && data.state.fileName.size() <= 255
          && data.state.fileName.matches('.*[.][xX][lL][sS][xX]')
          && data.state.sourceData is string && data.state.sourceData.size() <= 800000
          && (!data.state.keys().hasAny(['columnWidths']) || (data.state.columnWidths is list && data.state.columnWidths.size() == 14))
          && data.createdAt is timestamp && data.updatedAt == request.time
          && exists(/databases/$(database)/documents/academicYears/$(data.academicYearId))
          && canManageCourses(departmentId, data.membershipId);
      }
      allow read: if request.auth != null;
      allow create: if validSummaryWorkbook() && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
      allow update: if validSummaryWorkbook() && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /courses/{courseId} {
      function validCourseText(value) { return value is string && value.toUtf8().size() <= 65536; }
      function validCourseRow() {
        let data = request.resource.data;
        return request.auth != null
          && data.keys().hasAll(['sheetName', 'rowNumber', 'session', 'semester', 'code', 'course', 'type', 'credits', 'departmentId', 'departmentCode', 'sourceWorkbook', 'generation', 'revision', 'membershipId', 'savedBy', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['sheetName', 'rowNumber', 'session', 'semester', 'code', 'course', 'type', 'credits', 'departmentId', 'departmentCode', 'sourceWorkbook', 'generation', 'revision', 'membershipId', 'savedBy', 'createdAt', 'updatedAt'])
          && data.departmentId is string && data.departmentCode == get(/databases/$(database)/documents/departments/$(data.departmentId)).data.code
          && data.sourceWorkbook == 'departments/' + data.departmentId + '/courseWorkbooks/current'
          && data.generation is string && data.generation.matches('[a-zA-Z0-9_-]+') && courseId.matches(data.generation + '_[0-9]+')
          && data.revision is int && data.revision > 0 && data.rowNumber is int && data.rowNumber > 0
          && data.sheetName is string && data.sheetName.size() > 0 && data.sheetName.size() <= 31
          && validCourseText(data.session) && validCourseText(data.semester) && validCourseText(data.code)
          && validCourseText(data.course) && validCourseText(data.type) && validCourseText(data.credits)
          && data.membershipId is string && data.savedBy == request.auth.uid && data.createdAt == request.time && data.updatedAt == request.time
          && canManageCourses(data.departmentId, data.membershipId);
      }
      function canRemoveOldCourse() {
        let data = resource.data;
        let path = /databases/$(database)/documents/departments/$(data.departmentId)/courseWorkbooks/current;
        let manifest = exists(path) ? get(path).data : {};
        return request.auth != null && data.generation != manifest.get('generation', '')
          && ((data.savedBy == request.auth.uid && canManageCourses(data.departmentId, data.membershipId))
            || (manifest.get('savedBy', '') == request.auth.uid && canManageCourses(data.departmentId, manifest.membershipId)));
      }
      allow read: if request.auth != null;
      allow create: if validCourseRow();
      allow update: if false;
      allow delete: if canRemoveOldCourse();
    }

    function canSaveWorkbook(departmentId, yearId, semester, membershipId) {
      let member = get(/databases/$(database)/documents/memberships/$(membershipId)).data;
      let department = get(/databases/$(database)/documents/departments/$(departmentId)).data;
      let year = get(/databases/$(database)/documents/academicYears/$(yearId)).data;
      return request.auth != null && semester in ['sem1', 'sem2']
        && member.userId == request.auth.uid && member.status == 'accepted'
        && ((member.role == 'Admin' && year[semester].phase in ['Drafting', 'Plotting', 'Revision', 'Final'])
          || (member.role in ['Dean', 'Program Head'] && member.department == department.code
            && year[semester].phase in ['Drafting', 'Revision']));
    }

    function canPlotWorkbookRooms(yearId, semester, membershipId) {
      let member = get(/databases/$(database)/documents/memberships/$(membershipId)).data;
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let year = get(/databases/$(database)/documents/academicYears/$(yearId)).data;
      return request.auth != null && member.userId == request.auth.uid && member.status == 'accepted'
        && member.role in ['Registrar', 'Admin'] && profile.get('isActive', true) != false
        && semester in ['sem1', 'sem2'] && year[semester].phase in ['Drafting', 'Plotting', 'Revision', 'Final'];
    }

    function sameAuthoredScheduleValues(before, after) {
      return before.size() == 21 && after.size() == 21
        && [before[0], before[1], before[2], before[3], before[4], before[5], before[6], before[7], before[8], before[9], before[10], before[11], before[12], before[13], before[14], before[15], before[16], before[17], before[18]]
          == [after[0], after[1], after[2], after[3], after[4], after[5], after[6], after[7], after[8], after[9], after[10], after[11], after[12], after[13], after[14], after[15], after[16], after[17], after[18]];
    }

    match /schedules/{scheduleId} {
      function scheduleWorkbook(data) {
        let year = namedYear(data.academicYearId);
        return /databases/$(database)/documents/departments/$(data.departmentId)/workbooks/$(year)/semesters/$(data.semesterKey);
      }
      function validImportedSchedule() {
        let data = request.resource.data;
        let manifest = getAfter(scheduleWorkbook(data)).data;
        return request.auth != null && data.source == 'workbook' && data.schemaVersion == 2 && data.id == scheduleId
          && data.status in ['Draft', 'Plot'] && data.yearLevel in [1, 2, 3, 4]
          && data.sourceSheet is string && data.sourceRow is int && data.sourceRow > 0
          && data.department == get(/databases/$(database)/documents/departments/$(data.departmentId)).data.code
          && data.sourceWorkbook == 'departments/' + data.departmentId + '/workbooks/' + namedYear(data.academicYearId) + '/semesters/' + data.semesterKey
          && data.academicYear == get(/databases/$(database)/documents/academicYears/$(data.academicYearId)).data.academicYear
          && data.semester == (data.semesterKey == 'sem1' ? '1st Semester' : '2nd Semester')
          && data.workbookRevision == manifest.revision && data.workbookRevisionId == manifest.revisionId
          && manifest.savedBy == request.auth.uid && manifest.membershipId == data.membershipId && manifest.updatedAt == request.time
          && data.savedBy == request.auth.uid && data.createdAt is timestamp && data.updatedAt == request.time
          && canSaveWorkbook(data.departmentId, data.academicYearId, data.semesterKey, data.membershipId);
      }
      function validScheduleRoomPlot() {
        let data = request.resource.data;
        let member = get(/databases/$(database)/documents/memberships/$(data.plottedMembershipId)).data;
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let year = get(/databases/$(database)/documents/academicYears/$(resource.data.academicYearId)).data;
        return request.auth != null && resource.data.source == 'workbook' && resource.data.schemaVersion == 2
          && data.diff(resource.data).affectedKeys().hasOnly(['meetings', 'status', 'roomId', 'buildingId', 'roomIds', 'f2fRoom', 'registrarPlot', 'validationIssues', 'plottedBy', 'plottedAt', 'updatedAt', 'plottedMembershipId', 'rawValues', 'workbookRow', 'workbookSheetId'])
          && (!data.diff(resource.data).affectedKeys().hasAny(['rawValues']) || sameAuthoredScheduleValues(resource.data.rawValues, data.rawValues))
          && member.userId == request.auth.uid && member.status == 'accepted' && member.role in ['Registrar', 'Admin']
          && profile.get('isActive', true) != false && year[resource.data.semesterKey].phase in ['Drafting', 'Plotting', 'Revision', 'Final']
          && data.meetings is list && data.meetings.size() == resource.data.meetings.size()
          && data.roomIds is list && data.status == (data.roomIds.size() > 0 ? 'Plot' : 'Draft')
          && data.registrarPlot.version == 1 && data.registrarPlot.savedBy == request.auth.uid && data.registrarPlot.assignments is list
          && data.plottedBy == request.auth.uid && data.plottedAt == request.time && data.updatedAt == request.time;
      }
      allow read: if request.auth != null;
      allow create: if validImportedSchedule() && request.resource.data.createdAt == request.time;
      allow update: if (request.resource.data.get('plottedAt', null) == request.time && validScheduleRoomPlot())
        || (validImportedSchedule() && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.workbookRevision > resource.data.workbookRevision);
      allow delete: if request.auth != null
        && getAfter(scheduleWorkbook(resource.data)).data.revision > resource.data.workbookRevision
        && getAfter(scheduleWorkbook(resource.data)).data.updatedAt == request.time
        && getAfter(scheduleWorkbook(resource.data)).data.savedBy == request.auth.uid
        && canSaveWorkbook(resource.data.departmentId, resource.data.academicYearId, resource.data.semesterKey,
          getAfter(scheduleWorkbook(resource.data)).data.membershipId);
    }

    function namedYear(yearId) {
      return get(/databases/$(database)/documents/academicYears/$(yearId)).data.academicYear.replace('[ ]', '');
    }

    function testPath(data) {
      let year = namedYear(data.academicYearId);
      return /databases/$(database)/documents/departments/$(data.departmentId)/test_workbooks/$(year)/semesters/$(data.semester);
    }

    function legacyTestPath(data) {
      return /databases/$(database)/documents/departments/$(data.departmentId)/scheduleYears/$(data.academicYearId)/testSemesters/$(data.semester);
    }

    function namedLegacyTestPath(data) {
      let year = namedYear(data.academicYearId);
      return /databases/$(database)/documents/departments/$(data.departmentId)/scheduleYears/$(year)/testSemesters/$(data.semester);
    }

    function previousTestPath(data) {
      let year = namedYear(data.academicYearId);
      let document = data.semester + 'data';
      return /databases/$(database)/documents/departments/$(data.departmentId)/workbooks/$(year)/$(data.semester)/$(document);
    }

    function historicalTestManifest(data) {
      let named = namedLegacyTestPath(data);
      let legacy = legacyTestPath(data);
      return exists(named) ? get(named).data : (exists(legacy) ? get(legacy).data : {});
    }

    function previousTestManifest(data) {
      let path = previousTestPath(data);
      return exists(path) ? get(path).data : historicalTestManifest(data);
    }

    function priorTestManifest(data) {
      let path = testPath(data);
      return exists(path) ? get(path).data : previousTestManifest(data);
    }

    function productionPath(data) {
      let year = namedYear(data.academicYearId);
      return /databases/$(database)/documents/departments/$(data.departmentId)/workbooks/$(year)/semesters/$(data.semester);
    }

    function previousProductionManifest(data) {
      let year = namedYear(data.academicYearId);
      let document = data.semester + 'storage';
      let previous = /databases/$(database)/documents/departments/$(data.departmentId)/workbooks/$(year)/$(data.semester)/$(document);
      let named = /databases/$(database)/documents/departments/$(data.departmentId)/scheduleYears/$(year)/semesters/$(data.semester);
      let legacy = /databases/$(database)/documents/departments/$(data.departmentId)/scheduleYears/$(data.academicYearId)/semesters/$(data.semester);
      return exists(previous) ? get(previous).data : (exists(named) ? get(named).data : (exists(legacy) ? get(legacy).data : {}));
    }

    function priorProductionManifest(data) {
      let path = productionPath(data);
      return exists(path) ? get(path).data : previousProductionManifest(data);
    }

    function sameOrMovedSource(before, after) {
      return before.sourceWorkbook == after.sourceWorkbook
        || before.sourceWorkbook == 'departments/' + after.departmentId + '/workbooks/' + namedYear(after.academicYearId) + '/' + after.semester + '/' + after.semester + 'data'
        || before.sourceWorkbook == 'departments/' + after.departmentId + '/scheduleYears/' + after.academicYearId + '/testSemesters/' + after.semester
        || before.sourceWorkbook == 'departments/' + after.departmentId + '/scheduleYears/' + namedYear(after.academicYearId) + '/testSemesters/' + after.semester;
    }

    match /departments/{departmentId}/scheduleYears/{yearId}/semesters/{semester} {
      function validWorkbook() {
        let data = request.resource.data;
        let base = 'department-workbooks/' + departmentId + '/' + yearId + '/' + semester + '/revisions/';
        let grant = get(/databases/$(database)/documents/departments/$(departmentId)/scheduleYears/$(yearId)/semesters/$(semester)/uploads/$(data.revisionId)).data;
        return data.keys().hasAll(['schemaVersion', 'departmentId', 'departmentCode', 'academicYearId', 'academicYear', 'semester', 'fileName', 'workbookPath', 'editorStatePath', 'revision', 'revisionId', 'savedBy', 'membershipId', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['schemaVersion', 'departmentId', 'departmentCode', 'academicYearId', 'academicYear', 'semester', 'fileName', 'workbookPath', 'editorStatePath', 'revision', 'revisionId', 'savedBy', 'membershipId', 'createdAt', 'updatedAt'])
          && data.schemaVersion == 1 && data.departmentId == departmentId && yearId in [data.academicYearId, namedYear(data.academicYearId)] && data.semester == semester
          && data.departmentCode == get(/databases/$(database)/documents/departments/$(departmentId)).data.code
          && data.academicYear == get(/databases/$(database)/documents/academicYears/$(data.academicYearId)).data.academicYear
          && data.fileName is string && data.fileName.size() > 5 && data.fileName.size() <= 255 && data.fileName.matches('.*[.][xX][lL][sS][xX]')
          && data.revision is int && data.revision > 0 && data.revisionId is string && data.revisionId.matches('[a-zA-Z0-9_-]+')
          && data.workbookPath is string && data.editorStatePath == base + data.revisionId + '/editor.json'
          && data.savedBy == request.auth.uid && data.membershipId is string
          && data.createdAt is timestamp && data.updatedAt == request.time
          && grant.savedBy == request.auth.uid && grant.membershipId == data.membershipId
          && grant.createdAt > request.time - duration.value(10, 'm')
          && canSaveWorkbook(departmentId, data.academicYearId, semester, data.membershipId);
      }
      allow read: if request.auth != null;
      function legacyWorkbook() {
        let academicId = request.resource.data.academicYearId;
        let path = /databases/$(database)/documents/departments/$(departmentId)/scheduleYears/$(academicId)/semesters/$(semester);
        return exists(path) ? get(path).data : {};
      }
      allow create: if validWorkbook()
        && request.resource.data.revision == legacyWorkbook().get('revision', 0) + 1
        && request.resource.data.createdAt == legacyWorkbook().get('createdAt', request.time)
        && (request.resource.data.workbookPath == legacyWorkbook().get('workbookPath', '')
          || request.resource.data.workbookPath == 'department-workbooks/' + departmentId + '/' + yearId + '/' + semester + '/revisions/' + request.resource.data.revisionId + '/original.xlsx');
      allow update: if validWorkbook() && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && ((request.resource.data.workbookPath == resource.data.workbookPath && request.resource.data.fileName == resource.data.fileName)
          || request.resource.data.workbookPath == 'department-workbooks/' + departmentId + '/' + yearId + '/' + semester + '/revisions/' + request.resource.data.revisionId + '/original.xlsx');
      allow delete: if false;

      // Storage rules use this short-lived authorization to stay within their
      // two-document Firestore lookup limit while checking the current phase.
      match /uploads/{uploadId} {
        allow read: if request.auth != null && resource.data.savedBy == request.auth.uid;
        allow create: if uploadId.matches('[a-zA-Z0-9_-]+')
          && request.resource.data.keys().hasAll(['savedBy', 'membershipId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['savedBy', 'membershipId', 'academicYearId', 'createdAt'])
          && request.resource.data.savedBy == request.auth.uid && request.resource.data.membershipId is string
          && request.resource.data.createdAt == request.time
          && yearId in [request.resource.data.get('academicYearId', yearId), namedYear(request.resource.data.get('academicYearId', yearId))]
          && canSaveWorkbook(departmentId, request.resource.data.get('academicYearId', yearId), semester, request.resource.data.membershipId);
        allow update: if false;
        allow delete: if request.auth != null && resource.data.savedBy == request.auth.uid;
      }
    }
    // Isolated Firestore-only workbooks used by the testing tab.
    match /departments/{departmentId}/scheduleYears/{yearId}/testSemesters/{semester} {
      function validTestWorkbook() {
        let data = request.resource.data;
        let grant = get(/databases/$(database)/documents/departments/$(departmentId)/scheduleYears/$(yearId)/testSemesters/$(semester)/revisions/$(data.revisionId)).data;
        return request.auth != null
          && data.keys().hasAll(['schemaVersion', 'departmentId', 'departmentCode', 'academicYearId', 'academicYear', 'semester', 'fileName', 'sheetIds', 'sheetNames', 'selectedSheet', 'selectionJson', 'revision', 'revisionId', 'savedBy', 'membershipId', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['schemaVersion', 'departmentId', 'departmentCode', 'academicYearId', 'academicYear', 'semester', 'fileName', 'sheetIds', 'sheetNames', 'selectedSheet', 'selectionJson', 'revision', 'revisionId', 'savedBy', 'membershipId', 'createdAt', 'updatedAt'])
          && data.schemaVersion == 1 && data.departmentId == departmentId && yearId in [data.academicYearId, namedYear(data.academicYearId)] && data.semester == semester
          && data.departmentCode == get(/databases/$(database)/documents/departments/$(departmentId)).data.code
          && data.academicYear == get(/databases/$(database)/documents/academicYears/$(data.academicYearId)).data.academicYear
          && data.fileName is string && data.fileName.size() > 5 && data.fileName.size() <= 255 && data.fileName.matches('.*[.][xX][lL][sS][xX]')
          && data.sheetIds is list && data.sheetIds.size() > 0 && data.sheetIds.size() <= 1000
          && data.sheetNames is list && data.sheetNames.size() == data.sheetIds.size()
          && data.sheetIds.toSet().size() == data.sheetIds.size() && data.sheetNames.toSet().size() == data.sheetNames.size()
          && data.selectedSheet is string && data.selectedSheet in data.sheetNames
          && data.selectionJson is string && data.selectionJson.size() <= 2048
          && data.revision is int && data.revision > 0 && data.revisionId is string && data.revisionId.matches('[a-zA-Z0-9_-]+')
          && data.savedBy == request.auth.uid && data.membershipId is string
          && data.createdAt is timestamp && data.updatedAt == request.time
          && grant.savedBy == request.auth.uid && grant.membershipId == data.membershipId
          && grant.createdAt > request.time - duration.value(10, 'm')
          && canSaveWorkbook(departmentId, data.academicYearId, semester, data.membershipId);
      }
      function validTestWorkbookV2() {
        let data = request.resource.data;
        let lease = get(/databases/$(database)/documents/departments/$(departmentId)/scheduleYears/$(yearId)/testSemesters/$(semester)/saveLocks/current).data;
        return request.auth != null
          && data.keys().hasAll(['schemaVersion', 'workbookId', 'slot', 'departmentId', 'departmentCode', 'academicYearId', 'academicYear', 'semester', 'fileName', 'sheetIds', 'sheetNames', 'selectedSheet', 'selectionJson', 'revision', 'revisionId', 'savedBy', 'membershipId', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['schemaVersion', 'workbookId', 'slot', 'departmentId', 'departmentCode', 'academicYearId', 'academicYear', 'semester', 'fileName', 'sheetIds', 'sheetNames', 'selectedSheet', 'selectionJson', 'revision', 'revisionId', 'savedBy', 'membershipId', 'createdAt', 'updatedAt'])
          && data.schemaVersion == 2 && data.workbookId is string && data.workbookId.matches('test_[a-f0-9]{64}') && data.slot in ['a', 'b']
          && data.departmentId == departmentId && yearId in [data.academicYearId, namedYear(data.academicYearId)] && data.semester == semester
          && data.departmentCode == get(/databases/$(database)/documents/departments/$(departmentId)).data.code
          && data.academicYear == get(/databases/$(database)/documents/academicYears/$(data.academicYearId)).data.academicYear
          && data.fileName is string && data.fileName.size() > 5 && data.fileName.size() <= 255 && data.fileName.matches('.*[.][xX][lL][sS][xX]')
          && data.sheetIds is list && data.sheetIds.size() > 0 && data.sheetIds.size() <= 1000
          && data.sheetNames is list && data.sheetNames.size() == data.sheetIds.size()
          && data.sheetIds.toSet().size() == data.sheetIds.size() && data.sheetNames.toSet().size() == data.sheetNames.size()
          && data.selectedSheet is string && data.selectedSheet in data.sheetNames && data.selectionJson is string && data.selectionJson.size() <= 2048
          && data.revision is int && data.revision > 0 && data.revisionId is string && data.revisionId.matches('[a-zA-Z0-9_-]+')
          && data.savedBy == request.auth.uid && data.membershipId is string && data.createdAt is timestamp && data.updatedAt == request.time
