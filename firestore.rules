          && data.byteLength is int && data.byteLength > 0 && data.byteLength <= 921600
          && data.sourceWorkbook == 'departments/' + data.departmentId + '/scheduleYears/' + data.academicYearId + '/testSemesters/' + data.semester
          && data.departmentCode == get(/databases/$(database)/documents/departments/$(data.departmentId)).data.code
          && data.savedBy == request.auth.uid && data.createdAt == request.time
          && grant.savedBy == request.auth.uid && grant.membershipId == data.membershipId
          && grant.createdAt > request.time - duration.value(10, 'm')
          && canSaveWorkbook(data.departmentId, data.academicYearId, data.semester, data.membershipId);
      }
      function atomicV3(data, payload) {
        let path = testPath(data);
        let before = exists(path) ? get(path).data.get('revision', 0) : -1;
        let manifest = existsAfter(path) ? getAfter(path).data : {};
        return manifest.get('schemaVersion', 0) == 3
          // A newly created manifest separately validates its historical revision.
          // Existing manifests must advance; every atomic save publishes a fresh timestamp.
          && (before == -1 || manifest.revision == before + 1) && manifest.revisionId == payload.revisionId
          && manifest.savedBy == request.auth.uid && manifest.membershipId == payload.membershipId
          && manifest.updatedAt == request.time;
      }
      function stagedV3(data, payload) {
        let year = namedYear(data.academicYearId);
        let path = /databases/$(database)/documents/departments/$(data.departmentId)/test_workbooks/$(year)/semesters/$(data.semester)/saveLocks/current;
        return exists(path) && get(path).data.status == 'saving' && get(path).data.saveId == payload.revisionId
          && get(path).data.savedBy == request.auth.uid && get(path).data.membershipId == payload.membershipId
          && get(path).data.createdAt > request.time - duration.value(10, 'm');
      }
      function identityV3(data) {
        return data.schemaVersion == 3 && data.workbookId is string && data.workbookId.matches('test_[a-f0-9]{64}')
          && data.sheetIndex is int && data.sheetIndex >= 0 && data.sheetIndex < 1000 && data.sheetId == 'sheet_' + string(data.sheetIndex)
          && sheetId == data.workbookId + '_' + data.sheetId
          && data.sourceWorkbook == 'departments/' + data.departmentId + '/test_workbooks/' + namedYear(data.academicYearId) + '/semesters/' + data.semester
          && data.departmentCode == get(/databases/$(database)/documents/departments/$(data.departmentId)).data.code;
      }
      function grantV3(data, payload) {
        return request.auth != null && payload.savedBy == request.auth.uid && payload.updatedAt == request.time
          && payload.membershipId is string && payload.revisionId is string && payload.revisionId.matches('[a-zA-Z0-9_-]+')
          && (atomicV3(data, payload) || stagedV3(data, payload))
          && canSaveWorkbook(data.departmentId, data.academicYearId, data.semester, payload.membershipId);
      }
      function validParentV3(slot) {
        let data = request.resource.data;
        let metadata = data.slots[slot];
        return identityV3(data)
          && data.keys().hasAll(['schemaVersion', 'workbookId', 'sourceWorkbook', 'departmentId', 'departmentCode', 'academicYearId', 'semester', 'sheetId', 'sheetIndex', 'slots'])
          && data.keys().hasOnly(['schemaVersion', 'workbookId', 'sourceWorkbook', 'departmentId', 'departmentCode', 'academicYearId', 'semester', 'sheetId', 'sheetIndex', 'slots'])
          && data.slots is map && data.slots.keys().hasOnly(['a', 'b'])
          && metadata.keys().hasAll(['name', 'encoding', 'jsonByteLength', 'encodedLength', 'jsonHash', 'baseHash', 'partCount', 'partSlots', 'partRevisionIds', 'partHashes', 'revisionId', 'savedBy', 'membershipId', 'updatedAt'])
          && metadata.keys().hasOnly(['name', 'encoding', 'jsonByteLength', 'encodedLength', 'jsonHash', 'baseHash', 'partCount', 'partSlots', 'partRevisionIds', 'partHashes', 'revisionId', 'savedBy', 'membershipId', 'updatedAt'])
          && metadata.name is string && metadata.name.size() > 0 && metadata.name.size() <= 31 && metadata.encoding == 'gzip-base64'
          && metadata.jsonByteLength is int && metadata.jsonByteLength > 0 && metadata.jsonByteLength <= 52428800
          && metadata.encodedLength is int && metadata.encodedLength > 0 && metadata.encodedLength <= 73400320
          && metadata.jsonHash.matches('[a-f0-9]{64}') && metadata.baseHash.matches('[a-f0-9]{64}')
          && metadata.partCount is int && metadata.partCount > 0 && metadata.partCount <= 180
          && metadata.partSlots is list && metadata.partSlots.size() == metadata.partCount && metadata.partSlots.toSet().hasOnly(['a', 'b'])
          && metadata.partRevisionIds is list && metadata.partRevisionIds.size() == metadata.partCount
          && metadata.partHashes is list && metadata.partHashes.size() == metadata.partCount
          && grantV3(data, metadata);
      }
      function validChunkV3(chunkId, slot) {
        let data = request.resource.data;
        let part = data.slots[slot];
        return identityV3(data)
          && data.keys().hasAll(['schemaVersion', 'workbookId', 'sourceWorkbook', 'departmentId', 'departmentCode', 'academicYearId', 'semester', 'sheetId', 'sheetIndex', 'partIndex', 'slots'])
          && data.keys().hasOnly(['schemaVersion', 'workbookId', 'sourceWorkbook', 'departmentId', 'departmentCode', 'academicYearId', 'semester', 'sheetId', 'sheetIndex', 'partIndex', 'slots'])
          && data.partIndex is int && data.partIndex >= 0 && data.partIndex < 180 && chunkId == 'part_' + string(data.partIndex)
          && data.slots is map && data.slots.keys().hasOnly(['a', 'b'])
          && part.keys().hasAll(['encoding', 'data', 'byteLength', 'revisionId', 'savedBy', 'membershipId', 'updatedAt'])
          && part.keys().hasOnly(['encoding', 'data', 'byteLength', 'revisionId', 'savedBy', 'membershipId', 'updatedAt'])
          && part.encoding == 'gzip-base64' && part.data is string && part.data.matches('[A-Za-z0-9+/=]+')
          && part.byteLength is int && part.byteLength > 0 && part.byteLength <= 409600 && part.data.toUtf8().size() == part.byteLength
          && grantV3(data, part);
      }
      function parentWriteV3(creating) {
        let data = request.resource.data;
        let slot = inactiveSlot(data);
        return validParentV3(slot) && (creating
          ? data.slots.keys().hasOnly([slot])
          : (data.diff(resource.data).affectedKeys().hasOnly(['schemaVersion', 'sheetIndex', 'sourceWorkbook', 'slots'])
            && sameOrMovedSource(resource.data, data) && data.slots.diff(resource.data.slots).affectedKeys().hasOnly([slot])));
      }
      function chunkWriteV3(chunkId, creating) {
        let data = request.resource.data;
        let slot = inactiveChunkSlot(data);
        return validChunkV3(chunkId, slot) && (creating
          ? data.slots.keys().hasOnly([slot])
          : (data.diff(resource.data).affectedKeys().hasOnly(['schemaVersion', 'sheetIndex', 'sourceWorkbook', 'slots'])
            && sameOrMovedSource(resource.data, data) && data.slots.diff(resource.data.slots).affectedKeys().hasOnly([slot])));
      }
      allow read: if request.auth != null;
      allow create: if (request.resource.data.schemaVersion == 1 && validTestSheet())
        || (request.resource.data.schemaVersion == 2 && validTestSheetMetadata()
          && request.resource.data.slots.keys().hasOnly([inactiveSlot(request.resource.data)]))
        || (request.resource.data.schemaVersion == 3 && parentWriteV3(true));
      allow update: if resource.data.schemaVersion == 2 && request.resource.data.schemaVersion == 2 && validTestSheetMetadata()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots'])
        && request.resource.data.slots.diff(resource.data.slots).affectedKeys().hasOnly([inactiveSlot(request.resource.data)]);
      allow update: if request.resource.data.schemaVersion == 3 && resource.data.schemaVersion in [2, 3] && parentWriteV3(false);
      allow delete: if resource.data.schemaVersion == 1 && request.auth != null && resource.data.savedBy == request.auth.uid
        && (!exists(/databases/$(database)/documents/departments/$(resource.data.departmentId)/scheduleYears/$(resource.data.academicYearId)/testSemesters/$(resource.data.semester))
          || get(/databases/$(database)/documents/departments/$(resource.data.departmentId)/scheduleYears/$(resource.data.academicYearId)/testSemesters/$(resource.data.semester)).data.revisionId != resource.data.revisionId);

      match /chunks/{chunkId} {
        allow read: if request.auth != null;
        allow create: if request.resource.data.schemaVersion == 2 && validTestSheetPart(chunkId)
          && request.resource.data.slots.keys().hasOnly([inactiveChunkSlot(request.resource.data)]);
        allow create: if request.resource.data.schemaVersion == 3 && chunkWriteV3(chunkId, true);
        allow update: if resource.data.schemaVersion == 2 && request.resource.data.schemaVersion == 2 && validTestSheetPart(chunkId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots'])
          && request.resource.data.slots.diff(resource.data.slots).affectedKeys().hasOnly([inactiveChunkSlot(request.resource.data)]);
        allow delete: if false;
        allow update: if request.resource.data.schemaVersion == 3 && resource.data.schemaVersion in [2, 3] && chunkWriteV3(chunkId, false);
      }
      match /cells/{cellId} {
        function validCellV3() {
          let data = request.resource.data;
          let path = testPath(data);
          let manifest = getAfter(path).data;
          let parent = getAfter(/databases/$(database)/documents/test_sheets/$(sheetId)).data;
          return identityV3(data) && cellId.matches('[A-Z]{1,3}[1-9][0-9]{0,6}')
            && data.keys().hasAll(['schemaVersion', 'workbookId', 'sourceWorkbook', 'departmentId', 'departmentCode', 'academicYearId', 'semester', 'sheetId', 'sheetIndex', 'baseRevisionId', 'revision', 'revisionId', 'text', 'styleJson', 'savedBy', 'membershipId', 'updatedAt'])
            && data.keys().hasOnly(['schemaVersion', 'workbookId', 'sourceWorkbook', 'departmentId', 'departmentCode', 'academicYearId', 'semester', 'sheetId', 'sheetIndex', 'baseRevisionId', 'revision', 'revisionId', 'text', 'styleJson', 'savedBy', 'membershipId', 'updatedAt'])
            && data.sheetIndex < manifest.sheetIds.size() && manifest.sheetIds[data.sheetIndex] == data.sheetId
            && data.baseRevisionId == parent.slots[manifest.sheetSlots[data.sheetIndex]].revisionId
            && data.revision == manifest.revision && data.savedBy == request.auth.uid && data.updatedAt == request.time
            && (data.text == null || (data.text is string && data.text.toUtf8().size() <= 65536))
            && (data.styleJson == null || (data.styleJson is string && data.styleJson.toUtf8().size() <= 65536))
            && atomicV3(data, data) && canSaveWorkbook(data.departmentId, data.academicYearId, data.semester, data.membershipId);
        }
        allow read: if request.auth != null;
        allow create: if validCellV3();
        allow update: if validCellV3() && sameOrMovedSource(resource.data, request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sourceWorkbook', 'baseRevisionId', 'revision', 'revisionId', 'text', 'styleJson', 'savedBy', 'membershipId', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /comments/{commentId} {
      function roomExists(roomId) {
        return exists(/databases/$(database)/documents/rooms/$(roomId));
      }
      allow read: if request.auth != null && roomExists(resource.data.roomId);
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['roomId', 'authorId', 'authorName', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['roomId', 'authorId', 'authorName', 'text', 'createdAt'])
        && request.resource.data.roomId is string && roomExists(request.resource.data.roomId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 200
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.text.matches('[\\s\\S]*\\S[\\s\\S]*')
        && request.resource.data.createdAt == request.time;
      // The UI limits deletion to the author, Admin, or Registrar.
      allow delete: if request.auth != null;
      allow update: if false;
    }

    match /users/{userId}/roomCommentReads/{roomId} {
      function validReadPosition() {
        return request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['lastSeenAt'])
          && request.resource.data.keys().hasOnly(['lastSeenAt', 'seenComments'])
          && request.resource.data.get('seenComments', {}) is map
          && request.resource.data.lastSeenAt is timestamp
          && request.resource.data.lastSeenAt <= request.time
          && exists(/databases/$(database)/documents/rooms/$(roomId));
      }
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if validReadPosition();
      allow update: if validReadPosition() && request.resource.data.lastSeenAt >= resource.data.lastSeenAt;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if false;
    }

    // Audit events are written only by trusted server code, and cannot be edited by clients.
    match /logs/{logId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Preserve the project's existing access behavior for top-level documents.
    match /{collection}/{document} {
      allow read, write: if !(collection in ['test_sheets', 'sheets', 'comments', 'logs', 'courses', 'schedules']);
    }

    // Preserve existing nested-collection access except for private user records.
    match /{collection}/{document}/{subcollection}/{subdocument=**} {
      allow read, write: if !(collection in ['test_sheets', 'sheets', 'comments', 'logs', 'courses', 'schedules']) && (collection != 'users' || !(subcollection in ['notifications', 'roomCommentReads']))
        && (collection != 'departments' || !(subcollection in ['scheduleYears', 'workbooks', 'test_workbooks', 'courseWorkbooks', 'summaryWorkbooks']));
    }
  }
}
